#!/usr/bin/env bash
# Local commit gate: rejects the commit unless `make check-commit` passes.
#
# This runs the FAST SUBSET, not the full matrix. The full `make check-fast`
# moved to scripts/hooks/pre-push (#296): it measured ~8min in the realistic
# commit case, which is a cost paid per commit and was discouraging the small,
# frequent commits root CLAUDE.md asks for. Nothing was dropped -- pre-push
# still gates the whole matrix before anything reaches main, so the guarantee
# that main is never pushed broken is intact; only the *cadence* changed, from
# once-per-commit to once-per-push. See the check-commit comment in the
# Makefile for the per-step measurements behind the split.
#
# GitHub CI mirrors check-fast on every push to main as the backstop, but these
# hooks are what catch a regression before it leaves the machine. .git/hooks/
# isn't tracked by git, so scripts/install-hooks.sh is what makes both gates
# survive a fresh clone.
#
# Docs-only commits skip the cargo gate: it is a build/test/clippy run costing
# tens of seconds, and it cannot say anything about a change no cargo target
# reads.
#
# The inert-path allowlist lives in scripts/check-inert-paths.sh, shared with
# scripts/hooks/pre-push so the two gates cannot drift apart. It is an allowlist,
# so an unrecognized new file type fails safe (runs the gate).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# No --diff-filter: a deleted or renamed .rs must still trigger the gate.
staged="$(git diff --cached --name-only)"

if [ -n "$staged" ]; then
    # Runs BEFORE the docs-only early exit below: a reference/*.md edit is
    # docs-only, so a check placed after it would never see the commits most
    # likely to reintroduce broken LaTeX. Cheap enough (one grep over tracked
    # files) that it costs nothing to run on every commit.
    scripts/check-doc-latex.sh

    if printf '%s\n' "$staged" | scripts/check-inert-paths.sh; then
        echo "pre-commit: docs-only change — skipping 'make check-commit'."
        echo "pre-commit: (staged paths matched the inert allowlist in scripts/check-inert-paths.sh)"
        exit 0
    fi
fi

exec make check-commit
