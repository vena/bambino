#!/usr/bin/env bash
# Local commit gate: rejects the commit unless `make check-fast` passes.
# This repo has no GitHub remote yet, so CI never runs — this hook is the
# only backstop against regressions slipping in between review passes.
# Installed via scripts/install-hooks.sh since .git/hooks/ isn't tracked
# by git.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
exec make check-fast
