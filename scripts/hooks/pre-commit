#!/usr/bin/env bash
# Local commit gate: rejects the commit unless `make check-fast` passes.
# GitHub CI mirrors the same commands on every push to main, but this hook is
# what catches a regression before it becomes a commit. .git/hooks/ isn't
# tracked by git, so scripts/install-hooks.sh is what makes the gate survive a
# fresh clone.
#
# Docs-only commits skip the cargo gate: `make check-fast` is a multi-target
# build/test/clippy run costing minutes, and it cannot say anything about a
# change no cargo target reads.
#
# The list below is an ALLOWLIST of known-inert paths, not a denylist of code
# paths. Anything unrecognized runs the full gate, so a new file type fails
# safe (slow) rather than unchecked. Two deliberate exclusions:
#   - tests/mocks/*.json|.ndjson are NOT inert — tests deserialize them, so a
#     fixture edit can fail the suite.
#   - Cargo.toml/Cargo.lock/build.rs/*.rs/Makefile/.cargo/ are obviously not
#     inert and are covered by falling through to the catch-all.
# MODEL_MATRIX.csv is inert: it is referenced only in doc comments, never via
# include_str!/include_bytes!.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# No --diff-filter: a deleted or renamed .rs must still trigger the gate.
staged="$(git diff --cached --name-only)"

if [ -n "$staged" ]; then
    code_touched=0
    while IFS= read -r path; do
        [ -z "$path" ] && continue
        case "$path" in
            *.md|LICENSE|.gitignore|MODEL_MATRIX.csv) ;;
            .claude/*|docs/*|reference/*|.github/*) ;;
            *)
                code_touched=1
                break
                ;;
        esac
    done <<< "$staged"

    if [ "$code_touched" -eq 0 ]; then
        echo "pre-commit: docs-only change — skipping 'make check-fast'."
        echo "pre-commit: (staged paths matched the inert allowlist in scripts/hooks/pre-commit)"
        exit 0
    fi
fi

exec make check-fast
