#!/usr/bin/env bash
# Local push gate: rejects the push unless `make check-fast` passes.
#
# This is where the full six-feature-set matrix lives (#296). It used to run in
# pre-commit, where it cost ~8min on EVERY commit and so discouraged the small,
# frequent commits root CLAUDE.md asks for. Moving it here keeps the guarantee
# that matters -- nothing broken reaches main, because the matrix still runs
# locally before the push -- while changing the cadence from once-per-commit to
# once-per-push. A five-commit branch now pays it once instead of five times.
# pre-commit runs `make check-commit`, the ~65s subset; see the check-commit
# comment in the Makefile for the measurements behind the split.
#
# check-fast, NOT check-all: `make check-esp-idf` is already path-filtered CI
# (.github/workflows/esp-idf.yml) and `make check-embassy-probe` is manual, both
# deliberately kept off the commit path because they build whole external
# toolchains. Adding them here would put ~5.5min of Docker back on every push.
#
# .git/hooks/ isn't tracked by git, so scripts/install-hooks.sh is what makes
# this survive a fresh clone. GitHub CI remains the backstop after the push.
#
# Bypass with `git push --no-verify` when you genuinely need to (pushing a WIP
# branch that isn't meant to build). Don't make that a habit on main.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

zero='0000000000000000000000000000000000000000'

# stdin: <local ref> <local oid> <remote ref> <remote oid>, one line per ref.
# Collect the changed paths across every ref being pushed. Anything we cannot
# resolve confidently sets the fail-safe and runs the gate.
changed=''
force_gate=0
saw_ref=0

while read -r _local_ref local_oid _remote_ref remote_oid; do
    [ -z "${local_oid:-}" ] && continue
    saw_ref=1

    # Branch deletion: nothing to build.
    if [ "$local_oid" = "$zero" ]; then
        continue
    fi

    if [ "$remote_oid" = "$zero" ]; then
        # New branch on the remote. There is no remote tip to diff against, and
        # guessing a merge-base can silently under-report, so run the gate.
        force_gate=1
        break
    fi

    if ! git cat-file -e "$remote_oid^{commit}" 2>/dev/null; then
        # Remote tip isn't in our object store (stale fetch); can't diff it.
        force_gate=1
        break
    fi

    if ! range_paths="$(git diff --name-only "$remote_oid" "$local_oid" 2>/dev/null)"; then
        force_gate=1
        break
    fi
    changed="$changed$range_paths"$'\n'
done

# No refs on stdin at all (e.g. everything already up to date): nothing to gate.
if [ "$saw_ref" -eq 0 ]; then
    echo "pre-push: nothing to push — skipping 'make check-fast'."
    exit 0
fi

if [ "$force_gate" -eq 0 ]; then
    if [ -z "${changed//[[:space:]]/}" ]; then
        echo "pre-push: no file changes in the pushed range — skipping 'make check-fast'."
        exit 0
    fi

    # Same allowlist pre-commit uses, so a docs-only branch doesn't pay minutes.
    # check-doc-latex.sh still runs, mirroring pre-commit: a reference/*.md edit
    # is exactly the docs-only push the skip would otherwise wave through.
    if printf '%s' "$changed" | scripts/check-inert-paths.sh; then
        scripts/check-doc-latex.sh
        echo "pre-push: docs-only push — skipping 'make check-fast'."
        echo "pre-push: (changed paths matched the inert allowlist in scripts/check-inert-paths.sh)"
        exit 0
    fi
fi

echo "pre-push: running 'make check-fast' (full feature matrix, several minutes)…"
exec make check-fast
