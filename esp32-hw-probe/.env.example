# Copy to `.env` (gitignored) and fill in. Read at build time by build.rs and compiled
# into the probe binary via env!(..) — see src/main.rs.
#
# Values are taken literally: no shell expansion, no escaping. Split is on the first `=`
# only, so a password may contain `=`. Leading/trailing spaces are preserved as real
# characters — wrap the value in quotes to make them explicit. Lines starting with `#`
# and blank lines are ignored.
#
# A variable already set in the environment overrides the file, so a one-off
# `PROBE_PRINTER_IP=... cargo build` works without editing this.
#
# Note: these end up in the flashed binary, as they must for the device to use them.
# Nothing here is committed — `.env` is gitignored, and the serial is treated as a
# credential per the repo root's CLAUDE.md.

PROBE_WIFI_SSID=your-network
PROBE_WIFI_PASS=your-password

# Printer to handshake against. IP is dialled for TCP; the serial is passed separately as
# the TLS hostname, because the printer's leaf certificate is CN=<serial> with no SAN and
# verifying against the IP would fail the common-name check. This mirrors what
# src/client/connect.rs does.
PROBE_PRINTER_IP=192.168.1.x
PROBE_SERIAL=your-printer-serial

# --- Optional ---------------------------------------------------------------------
# Keys below are forwarded only when set. Read them with option_env!, never env!:
# env! on an absent key is a compile error, which would make the key required again
# and break every probe that does not use it.

# LAN-mode access code: the MQTT password, and the FTPS password paired with user `bblp`.
# Not needed for a TLS-handshake probe (the handshake completes before authentication),
# but any probe that subscribes to a topic or lists a directory will want it. Treat it as
# a credential — same standing as the serial, per the repo root's CLAUDE.md.
#PROBE_ACCESS_CODE=00000000
