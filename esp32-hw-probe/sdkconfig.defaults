# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
# You might have to increase this further if you allocate large stack variables in the main task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Increase a bit these stack sizes as they are also a bit too small by default
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# You might have to increase this further if you spawn your own Rust threads 
# that allocate large stack variables; or better yet - use 
# `std::thread::Builder::new().stack_size(XXX)` for spawning
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# The issue #145 probe links Wi-Fi, esp-tls and mbedTLS, which the earlier timer-only
# probes did not: the image is ~1.18MB against the default `single_app` layout's 1MB app
# partition, so the flash fails with `image_too_big` before anything runs. The C6 on hand
# reports 4MB of flash while the build defaulted to a 2MB layout, so declaring the real
# size and taking the large single-app table (1.5MB factory partition) is enough — no
# custom partitions.csv needed.
#
# Deliberately not solved by shrinking the binary: the obvious lever is
# CONFIG_MBEDTLS_ERROR_STRINGS=n, and this probe's whole output is *why* a handshake was
# rejected. Trading away the error strings would save space by destroying the evidence.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Generates the esp-tls client-session bindings (`esp_tls_get_client_session`,
# `esp_tls_cfg_t.client_session`) that the GitHub issue #160 follow-up needs to test TLS
# session resumption. Off by ESP-IDF default, which is why those symbols are absent from
# `bindings.rs` in a stock build; the mbedTLS half (CONFIG_MBEDTLS_CLIENT_SSL_SESSION_TICKETS)
# is already on without asking. Consumers wanting resumption would have to set this too, so
# any bambino code using those symbols must be `#[cfg(esp_idf_esp_tls_client_session_tickets)]`
# gated rather than assumed present.
CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS=y

# mbedTLS's own account of the handshake. esp-tls installs the debug callback only under
# CONFIG_MBEDTLS_DEBUG (`esp_tls_mbedtls.c:188`), so this is the switch that makes any of
# mbedTLS's reasoning visible. It earned its place twice: at level 3 it settled session
# resumption (the ClientHello hex dump proved we offered the printer's own session ID back
# and it declined — timing alone could not separate that from never having offered it), and
# at level 2 it exposes the negotiated ECDH curve, which is what the round below is about.
#
# Diagnostic only. Both options cost binary size and print per handshake; turn them off for
# a clean timing run.
# Level 2 (INFO), not 3. Level 2 still prints `ssl_tls12_client.c:1805 ECDH curve: <name>`,
# which is the line this round turns on, and it maps to ESP_LOGI
# (`port/mbedtls_debug.c:73`) so the default log ceiling already passes it — no
# CONFIG_LOG_MAXIMUM_LEVEL change needed. Level 3 was used to settle resumption and dumps
# hex per record, which inflated handshake timings roughly 3x and made that round's numbers
# unusable for measurement. Do not raise this while measuring.
#
# OFF while measuring, and this is not a nicety. mbedTLS prints from *inside*
# `esp_tls_low_level_conn`, so its serial output lands inside the region the handshake
# instrumentation measures. Level 2 inflated `us in esp_tls` from ~409ms to ~1450ms and
# collapsed the step count from ~50 to 9 — a distortion larger than any effect being
# measured. Turn it on to answer a protocol question, read the answer, turn it back off
# before believing a single number.
CONFIG_MBEDTLS_DEBUG=n

# bambino reports its per-handshake breakdown (steps, compute, polling) at debug level, and
# that line is the whole instrument for a timing round. CONFIG_LOG_MAXIMUM_LEVEL is a
# compile-time ceiling, so leaving it at the Info default strips those calls from the binary
# and no runtime esp_log_level_set / set_target_level call can bring them back.
#
# This raises only the ceiling. Per-target levels stay where they are, and main() lifts just
# `bambino::io::esp_idf` -- ESP-IDF's own components keep logging at their default level
# rather than flooding the transcript this probe exists to read.
#
# Unrelated to CONFIG_MBEDTLS_DEBUG above: that one prints from inside the region being
# measured and distorts it. This one only widens what the Rust log facade will emit.
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# THE POINT OF THIS ROUND. mbedTLS ranks x25519 first among supported groups, so a stock
# build negotiates `ECDH curve: x25519` — and the ESP32-C6's ECC accelerator handles
# P-192/P-256 only (`components/mbedtls/port/ecc/ecc_alt.c:56`), so that key exchange runs
# entirely in software while the hardware idles. Measured cost on a P1S handshake: one
# ~265ms step out of ~410ms of local compute. Turning the curve off leaves secp256r1 at the
# head of the list, which does route to `esp_mbedtls_ecp_point_multiply`.
#
# This is a consumer-side sdkconfig setting, not something bambino can set for anyone — the
# crate can only document it. Confirm the negotiated curve in the log rather than assuming
# the substitution happened, and watch for a handshake that now fails outright, which would
# mean the printer cannot do P-256 and the curve has to stay.
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=n
